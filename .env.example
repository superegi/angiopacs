# ============================================================
# AngioPACS / NeuroPACS - ejemplo de configuración
# Copiar a .env o ejecutar:
#   ./scripts/generate_env.sh
#
# IMPORTANTE:
# - No subir .env a Git.
# - Generar claves nuevas para cada instalación.
# - Orthanc queda solo en localhost por defecto.
# ============================================================

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_USER=admin_angio
POSTGRES_PASSWORD=GENERAR_CLAVE_SEGURA
POSTGRES_DB=angiopacs_db

# ----------------------------
# FastAPI / NeuroPACS
# ----------------------------
PORT_BACKEND=8000
ANGIOPACS_USER=admin
ANGIOPACS_PASSWORD=GENERAR_CLAVE_SEGURA
ANGIOPACS_SESSION_SECRET=GENERAR_SECRETO_LARGO
ANGIOPACS_BOOTSTRAP_ADMIN=true

# ----------------------------
# Telegram
# ----------------------------
TELEGRAM_TOKEN=CAMBIAR_TOKEN_TELEGRAM

# ----------------------------
# Orthanc - puertos locales
# Por seguridad quedan ligados a 127.0.0.1 en docker-compose.
# Futuro: publicar vía Traefik/VPN/firewall.
# ----------------------------
PORT_ORTHANC_WEB=8042
PORT_ORTHANC_DICOM=4242
ORTHANC_NAME=NeuroPACS
ORTHANC_AETITLE=ORTHANC

# URL interna Docker usada por backend.
ORTHANC_URL=http://orthanc-pacs:8042

# URL pública/local usada para generar enlaces en la web.
ORTHANC_PUBLIC_URL=http://localhost:8042

# En desarrollo local puede quedar false porque Orthanc está limitado a 127.0.0.1.
# En producción/publicación cambiar a true.
ORTHANC_AUTHENTICATION_ENABLED=false

# ----------------------------
# Orthanc - usuarios
# Nota: Orthanc Basic Auth no diferencia permisos finos.
# Para permisos por usuario/grupo se usará Authorization Plugin más adelante.
# ----------------------------
ORTHANC_BACKEND_USER=angio_backend
ORTHANC_BACKEND_PASSWORD=GENERAR_CLAVE_SEGURA

ORTHANC_ADMIN_USER=egidio_orthanc
ORTHANC_ADMIN_PASSWORD=GENERAR_CLAVE_SEGURA

ORTHANC_VISIT_USER=visita
ORTHANC_VISIT_PASSWORD=GENERAR_CLAVE_SEGURA
TZ=America/Santiago
ORTHANC_BIND_ADDRESS=127.0.0.1
WEB_PUBLIC_URL=http://localhost:8000
ANGIOPACS_PUBLIC_URL=http://localhost:8000
DATABASE_URL=postgresql://admin_angio:CAMBIAR_POSTGRES_PASSWORD@postgres-db:5432/angiopacs_db

# === Despliegue / URLs públicas / red ===
# TZ:
#   Zona horaria del despliegue.
#
# ORTHANC_BIND_ADDRESS:
#   Dirección donde Docker publica Orthanc en el host.
#   127.0.0.1 = solo accesible desde el mismo servidor.
#   0.0.0.0 = accesible desde red/VPN/reverse proxy.
#   En producción con Traefik externo por VPN puede requerirse 0.0.0.0.
#
# WEB_PUBLIC_URL:
#   URL pública de la web AngioPACS.
#   Ejemplo local: http://localhost:8000
#   Ejemplo producción: https://TU-DOMINIO-WEB
#
# ANGIOPACS_PUBLIC_URL:
#   Alias de URL pública de AngioPACS para compatibilidad con código/scripts.
#
# DATABASE_URL:
#   URL SQLAlchemy opcional. Si docker-compose define DATABASE_URL directamente,
#   esta variable puede no ser usada por el contenedor.
#   El script de generación de .env debe generar y aplicar la contraseña de PostgreSQL.
